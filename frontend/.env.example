# Base URL backend FastAPI (lokal)
# Opsi A: pakai proxy Vite (biarkan kosong, default ke /api via proxy)
# Opsi B: isi URL absolut kalau backend jalan di mesin/server lain
# Komang SAC memakai port 8001, bukan 8000. Port 8000 dipakai aplikasi lain
# (VibeSift) di mesin yang sama. Kalau dua backend merebut satu port, frontend
# diam-diam memakai API aplikasi yang salah dan error-nya muncul sebagai
# "Not Found" yang menyesatkan.
VITE_API_BASE_URL=http://127.0.0.1:8001

# Supabase (opsional — hanya bila frontend mau Realtime langsung)
VITE_SUPABASE_URL=https://cssajztordwhsqaonzgn.supabase.co
VITE_SUPABASE_ANON_KEY=
