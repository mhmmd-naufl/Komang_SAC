# Salin file ini jadi .env lalu isi sesuai environment kamu.
#   copy .env.example .env      (Windows PowerShell)
#   cp .env.example .env        (macOS / Linux / Git Bash)
# JANGAN commit .env yang sudah terisi.

# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=https://cssajztordwhsqaonzgn.supabase.co

# WAJIB: service_role key (BUKAN anon key).
# Backend wajib memakai service_role: key ini MELALUI RLS dan boleh menulis,
# sedangkan anon key tidak. Catatan: RLS saat ini baru aktif di tabel
# `expenses` -- 5 tabel lain belum (lihat migrate.sql bagian [7]).
# service_role key HANYA boleh ada di backend -- jangan pernah ditaruh di
# frontend/ atau .env frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Alias lama, dipakai kalau variabel di atas kosong.
SUPABASE_SERVICE_KEY=

# Catatan: anon key tidak dipakai backend. Frontend memakai anon key-nya
# sendiri lewat VITE_ vars di frontend/.env (lihat frontend/.env.example).

# --- Hapus Foto Otomatis (Storage TTL) ---
# Supabase free tier TIDAK punya fitur hapus-otomatis, jadi penghapusan foto
# dijalankan dari luar lewat GitHub Actions (.github/workflows/cleanup-photos.yml)
# yang memanggil POST /internal/cleanup-fotos sekali sehari.
#
# Dua langkah supaya fitur ini hidup:
#   1. Isi CLEANUP_TOKEN di .env backend (bisa pakai nilai yang sama persis).
#   2. Di GitHub repo: Settings > Secrets and variables > Actions, buat dua
#      secret -- BACKEND_URL (URL produksi backend, tanpa slash di belakang)
#      dan CLEANUP_TOKEN (nilai yang sama dengan di .env backend).
# Tanpa kedua secret itu workflow-nya tidak error, hanya melewati dengan
# peringatan kuning.
CLEANUP_TOKEN=
PHOTO_TTL_DAYS=7

# --- Auth ---
# String acak kuat. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Jangan diganti setelah ada user login, karena semua token jadi tidak valid.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Info bisnis (untuk template pesan WhatsApp) ---
BUSINESS_NAME=Komang SAC
BUSINESS_PHONE=628980570911
BUSINESS_EMAIL=hasby4883@gmail.com
BUSINESS_ADDRESS=Jl. Cisadane No.3, Lingkungan Mojoroto R, Singonegaran, Kec. Banyuwangi, Kabupaten Banyuwangi, Jawa Timur 68415
TECHNICIAN_COMMISSION_PERCENT=40

# --- Info Admin ---
ADMIN_NAME=Achmad hasby dzatul akmam
ADMIN_PHONE=628980570911

# --- Drop Points ---
# Format: nama|alamat|wa|aktif (pisah dengan ; untuk multiple)
DROP_POINTS=Dolaycut|Jalan Kyai Haji Wahid Hasyim No. 76, Kabupaten Banyuwangi, Jawa Timur 68461, Indonesia|6289680841298|true;Outlet Utama|Jl. Cisadane No.3, Lingkungan Mojoroto R, Singonegaran, Kec. Banyuwangi, Kabupaten Banyuwangi, Jawa Timur 68415|628980570911|true

# --- Payment Methods ---
# Metode bayar yang diterima outlet, dipisah koma. Nilai yang dikenal:
# tunai, transfer, qris (alias "qr" otomatis dibaca sebagai "qris").
# Hanya metode di sini yang ditampilkan frontend dan diterima backend.
ACCEPTED_PAYMENTS=tunai,qr

# Jam operasional outlet, ditampilkan ke konsumen di halaman status.
BUSINESS_HOURS=09.00-20.00 WIB

# --- Ringkasan AI (opsional) ---
# Kalau kosong, dashboard tetap jalan: ringkasan dihitung dari aturan di
# analytics.py (sumber='fallback'). Tidak ada error, tidak ada downtime.
# Ambil key gratis di https://openrouter.ai/keys
#
# Yang dikirim ke OpenRouter hanya angka agregat. Kode transaksi, nomor
# telepon, dan nama orang tidak pernah ikut. Endpoint-nya admin-only.
OPENROUTER_API_KEY=

# Model gratis. Kalau yang ini habis kuota atau dihapus dari katalog,
# ganti ke model lain dari https://openrouter.ai/models?q=:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Daftar cadangan (dipisah koma), dicoba berurutan kalau model di atas
# kena 429/404/timeout. Kalau baris ini diisi, OPENROUTER_MODEL di atas
# diabaikan -- masukkan model utama ke urutan pertama di sini.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# --- CORS (domain frontend yang boleh memanggil API) ---
# WAJIB diisi saat deploy (Railway): daftar origin frontend dipisah koma,
# tanpa slash di akhir. Kalau kosong, fallback "*" terpakai (cocok untuk
# dev lokal, tapi jangan dibiarkan begitu di produksi).
#
# FRONTEND_ORIGINS=https://komang-sac.pages.dev,https://komangsac.id
FRONTEND_ORIGINS=
