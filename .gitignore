# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Env & secrets ---
# Semua .env dan turunannya (produksi/staging/dev) tidak boleh ikut commit.
# Pola ".env.*" juga menutup .env.local dan .env.*.local.
# File contoh dikecualikan dengan tanda ! -- berlaku juga untuk
# frontend/.env.example karena polanya tanpa slash.
.env
.env.*
!.env.example

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Test & cache ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# --- Scratch / debugging satu kali ---
# Skrip cek-cepat / patch-cepat yang dipakai sekali lalu ditinggalkan.
# Kalau sudah selesai, hapus dari disk juga: git rm <file>
/_*.py
/_temp*.txt

# --- Sisa file temp dari edit / merge ---
*.bak
*.orig
*.rej

# --- Repo privat (file sensitif) ---
# Folder ini adalah repo git TERPISAH yang di-push ke GitHub PRIVATE.
# Repo publik tidak boleh pernah ikut membawanya.
/privat/

# --- Proyek TERPISAH ---
# Rentalyzer (sistem rental). Bukan bagian Komang SAC, punya repo git
# sendiri, tidak ikut ter-commit. Folder tetap ada di disk -- hanya
# diabaikan oleh git.
Rentalyzer/
